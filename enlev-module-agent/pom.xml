<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.enlev.ainb</groupId>
        <artifactId>enlev</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>enlev-module-agent</artifactId>

    <name>${project.artifactId}</name>
    <description>
        AI 助手模块：工具体系、Agent 循环、Plan 预览确认与权限网关。

        为什么独立成模块，而不是并进 enlev-module-ai：
        ai 模块的提交全部来自上游且仍在活跃维护，agent 代码若与它同目录交织，
        每次 merge 都要人工判断。独立成模块后，对 ai 的改动只有「新增 api/ 目录」这一处。

        依赖方向是单向的：agent → ai.api / infra.api / bpm.api / system.api，
        agent 是唯一的聚合层，不被任何模块反向依赖。
    </description>

    <properties>
        <!-- 🔴 与 enlev-module-ai 对齐：spring-ai 锁 1.1.8。
             spring-ai-alibaba-graph-core:1.1.2.2 传递声明的是 spring-ai 1.1.2，
             若不在此用 bom 强制，Maven 仲裁会让 graph-core 分支的 1.1.2 覆盖 ai 模块的 1.1.8
             （实测 dependency:tree -Dverbose：1.1.8 被 "omitted for conflict with 1.1.2"），
             而 ai 模块 + dashscope starter 是按 1.1.8 编译的，降级到 1.1.2 有 NoSuchMethodError 风险。
             P0 spike 已验证 graph-core 1.1.2.2 运行在 spring-ai 1.1.8 上正常。 -->
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 被聚合的各业务模块：只调它们的 api 包，不碰内部实现 -->
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-module-bpm</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-module-ai</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 工作流执行内核：Spring AI Alibaba Graph（LangGraph 式有状态图引擎）。
             🔴 版本锁定 1.1.2.2，与 enlev-module-ai 的 spring-ai-alibaba-starter-dashscope 同版本线
             （见设计方案「一之二」/ spike 结论 SR-5）：2.0 线需 Boot 4.0，与本项目 3.5.15 不兼容，
             只随 1.x 安全补丁升级，不跨 2.0。graph-core 传递 spring-ai-commons/model 1.1.8 + reactor，
             与 ai 模块 brought-in 的 spring-ai 1.1.8 收敛一致（P0 spike 已验依赖树无冲突）。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
            <version>1.1.2.2</version>
        </dependency>

        <!-- script 节点：GraalJS 沙箱执行用户脚本。显式声明而非靠 infra 传递进来——
             本模块直接 import org.graalvm.polyglot.*，哪天 infra 不再依赖它，这里会编译失败
             而不是运行期莫名 ClassNotFound（与下方 job starter 同一纪律）。版本由 enlev-dependencies 统一管。 -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js</artifactId>
            <type>pom</type>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 防护组件：只为 RateLimiterRedisDAO（Redisson RRateLimiter）——B2-5 给 webhook 匿名入口加限流。
             🔴 这是 agent 模块首次引入 Redis 依赖（此前全模块 grep Redisson/RedisTemplate 均 0 命中）。
             🔴 刻意不用同 starter 里的 @RateLimiter 注解：注解的 count() 是 int（RateLimiter.java:38），
             而注解属性必须是编译期常量，配不了 yaml；本模块要求阈值走配置（AgentWebhookProperties），
             故直接注入 DAO 调 tryAcquire(key, count, time, timeUnit)——那四个参数全是运行期值。
             显式声明而非靠 infra 传递进来，与下方 job starter 同一纪律。 -->
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-spring-boot-starter-protection</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Job 定时任务：计量日志的保留期清理（方案 §16 第 6 条）。
             显式声明而不是靠 infra 传递进来 —— 本模块直接 implements JobHandler，
             哪天 infra 不再依赖它，这里会编译失败而不是莫名其妙少个 bean -->
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>cn.enlev.ainb</groupId>
            <artifactId>enlev-spring-boot-starter-test</artifactId>
        </dependency>
    </dependencies>

</project>
