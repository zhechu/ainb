{"dslVersion":"1.0","id":"daily_inspection_table_create","name":"设备巡检表创建流程","description":"每日8点检查biz_xpy_e2e_gate_probe表是否存在，不存在则预览DDL并提BPM审批，审批通过后建表",
"trigger":{"type":"trigger.schedule","config":{"cron":"0 0 8 * * ?"}},
"variables":[
  {"key":"input","type":"object"},
  {"key":"physical_tables","type":"object"},
  {"key":"table_exists","type":"boolean"},
  {"key":"preview_result","type":"object"},
  {"key":"bpm_approved","type":"boolean"},
  {"key":"create_result","type":"object"},
  {"key":"output","type":"string"}
],
"nodes":[
  {"id":"check_table","type":"tool","name":"检查物理表是否存在","config":{"toolId":"datamodel_physical_tables","args":{"keyword":"biz_xpy_e2e_gate_probe"},"outputVar":"physical_tables"}},
  {"id":"judge_exist","type":"script","name":"判断表是否存在","config":{"code":"var items = (state.physical_tables && state.physical_tables.items) || []; return items.some(function(item){ return item.tableName === 'biz_xpy_e2e_gate_probe'; });","outputVar":"table_exists"}},
  {"id":"condition_exist","type":"condition.rule","name":"表存在判断","config":{"branches":[{"target":"exists","conditions":[{"var":"table_exists","op":"is_true"}]}],"default":"not_exists"}},
  {"id":"report_exists","type":"llm","name":"表已存在提示","config":{"prompt":"表 biz_xpy_e2e_gate_probe 已存在，本次无需创建。","outputVar":"output"}},
  {"id":"preview_ddl","type":"tool","name":"预览建表DDL","config":{"toolId":"datamodel_preview_ddl","args":{"model":{"tableName":"biz_xpy_e2e_gate_probe","tableComment":"设备巡检结果记录","columns":[{"columnName":"inspector","columnComment":"巡检人","columnType":"STRING","length":64,"nullable":true,"primaryKey":false},{"columnName":"inspect_time","columnComment":"巡检时间","columnType":"DATETIME","nullable":true,"primaryKey":false},{"columnName":"device_code","columnComment":"设备编号","columnType":"STRING","length":64,"nullable":true,"primaryKey":false},{"columnName":"conclusion","columnComment":"巡检结论","columnType":"TEXT","nullable":true,"primaryKey":false},{"columnName":"remark","columnComment":"备注","columnType":"TEXT","nullable":true,"primaryKey":false}]},"outputVar":"preview_result"}},
  {"id":"approve","type":"hitl.bpm_approval","name":"建表审批","config":{"bpmProcessDefKey":"agent_datamodel_create","injectManifest":true}},
  {"id":"condition_approve","type":"condition.rule","name":"审批结果判断","config":{"branches":[{"target":"approved","conditions":[{"var":"bpm_approved","op":"is_true"}]}],"default":"rejected"}},
  {"id":"create_table","type":"tool","name":"创建数据表","config":{"toolId":"datamodel_create","args":{"model":{"tableName":"biz_xpy_e2e_gate_probe","tableComment":"设备巡检结果记录","columns":[{"columnName":"inspector","columnComment":"巡检人","columnType":"STRING","length":64,"nullable":true,"primaryKey":false},{"columnName":"inspect_time","columnComment":"巡检时间","columnType":"DATETIME","nullable":true,"primaryKey":false},{"columnName":"device_code","columnComment":"设备编号","columnType":"STRING","length":64,"nullable":true,"primaryKey":false},{"columnName":"conclusion","columnComment":"巡检结论","columnType":"TEXT","nullable":true,"primaryKey":false},{"columnName":"remark","columnComment":"备注","columnType":"TEXT","nullable":true,"primaryKey":false}]},"outputVar":"create_result"}},
  {"id":"report_success","type":"llm","name":"建表成功提示","config":{"prompt":"表 biz_xpy_e2e_gate_probe 创建成功。预览结果：{{$.preview_result}}","outputVar":"output"}},
  {"id":"report_reject","type":"llm","name":"审批驳回提示","config":{"prompt":"审批未通过，未创建表。","outputVar":"output"}}
],
"edges":[
  {"from":"START","to":"check_table"},
  {"from":"check_table","to":"judge_exist"},
  {"from":"judge_exist","to":"condition_exist"},
  {"from":"condition_exist","type":"conditional","cases":{"exists":"report_exists","not_exists":"preview_ddl"},"default":"preview_ddl"},
  {"from":"preview_ddl","to":"approve"},
  {"from":"approve","to":"condition_approve"},
  {"from":"condition_approve","type":"conditional","cases":{"approved":"create_table","rejected":"report_reject"},"default":"report_reject"},
  {"from":"create_table","to":"report_success"},
  {"from":"report_success","to":"END"},
  {"from":"report_reject","to":"END"},
  {"from":"report_exists","to":"END"}
]}]
