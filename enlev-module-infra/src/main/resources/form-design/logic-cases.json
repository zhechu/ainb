      "data": { "startDate": "2026-09-01", "endDate": "" },
      "rules": [
        {
          "id": "ge",
          "trigger": "CHANGE",
          "when": {
            "logic": "AND",
            "items": [
              { "field": "endDate", "operator": "GE", "valueType": "FIELD", "value": "startDate" }
            ]
          },
          "then": [{ "type": "REQUIRE", "target": "ge" }]
        },
        {
          "id": "le",
          "trigger": "CHANGE",
          "when": {
            "logic": "AND",
            "items": [
              { "field": "endDate", "operator": "LE", "valueType": "FIELD", "value": "startDate" }
            ]
          },
          "then": [{ "type": "REQUIRE", "target": "le" }]
        }
      ],
      "expect": {
        "state": { "ge": { "required": false }, "le": { "required": false } },
        "stable": true
      }
    },

