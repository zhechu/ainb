          "trigger": "CHANGE",
          "when": null,
          "then": [{ "type": "HIDE", "target": "x" }]
        },
        {
          "id": "r2",
          "trigger": "SUBMIT",
          "when": null,
          "then": [{ "type": "REQUIRE", "target": "y" }]
        }
      ],
      "expect": {
        "state": { "x": { "visible": true }, "y": { "required": true } },
        "stable": true
      }
    },

    {
      "name": "⚠️ 链式联动 A→B→C 靠不动点迭代生效",
      "trigger": "CHANGE",
      "data": { "a": 1 },
      "rules": [
        {
          "id": "a2b",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "a", "operator": "EQ", "value": 1 }] },
          "then": [{ "type": "SET_VALUE", "target": "b", "payload": { "value": 2 } }]
        },
        {
          "id": "b2c",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "b", "operator": "EQ", "value": 2 }] },
          "then": [{ "type": "SET_VALUE", "target": "c", "payload": { "value": 3 } }]
        },
        {
          "id": "c2req",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "c", "operator": "EQ", "value": 3 }] },
          "then": [{ "type": "REQUIRE", "target": "d" }]
        }
      ],
      "expect": {
        "data": { "b": 2, "c": 3 },
        "state": { "d": { "required": true } },
        "stable": true
      }
    },
    {
      "name": "⚠️ 同轮内互相翻转的两条规则仍然收敛：整轮结果不变就是不动点",
      "_note": [
        "flip 在一轮内被翻成 1 又被翻回 0，整轮结束时与轮初相同，因此判定为已收敛。",
        "这是同轮顺序执行的直接结果，容易误以为「互相翻转必然不收敛」——",
        "真正不收敛要求整轮函数的周期大于 1，见下一条用例。",
        "两端的判定必须一致，所以这条也要钉住。"
      ],
      "trigger": "CHANGE",
      "data": { "flip": 0 },
      "rules": [
        {
          "id": "up",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "flip", "operator": "EQ", "value": 0 }] },
          "then": [{ "type": "SET_VALUE", "target": "flip", "payload": { "value": 1 } }]
        },
        {
          "id": "down",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "flip", "operator": "EQ", "value": 1 }] },
          "then": [{ "type": "SET_VALUE", "target": "flip", "payload": { "value": 0 } }]
        }
      ],
      "expect": { "data": { "flip": 0 }, "stable": true }
    },
    {
      "name": "⚠️ 三段环形赋值真的不收敛，stable=false 但不抛异常",
      "_note": [
        "规则声明顺序是 a==2→0、a==1→2、a==0→1，起始 a=0。",
        "逐轮结果：1 → 2 → 1 → 2 …… 整轮函数周期为 2，永远不会与轮初相同。",
        "达到 maxPasses 后停止并标记 stable=false —— 不抛异常，",
        "一条配歪的规则不该让整个提交流程失败。"
      ],
      "trigger": "CHANGE",
      "data": { "a": 0 },
      "rules": [
        {
          "id": "r1",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "a", "operator": "EQ", "value": 2 }] },
          "then": [{ "type": "SET_VALUE", "target": "a", "payload": { "value": 0 } }]
        },
        {
          "id": "r2",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "a", "operator": "EQ", "value": 1 }] },
          "then": [{ "type": "SET_VALUE", "target": "a", "payload": { "value": 2 } }]
        },
        {
          "id": "r3",
          "trigger": "CHANGE",
          "when": { "logic": "AND", "items": [{ "field": "a", "operator": "EQ", "value": 0 }] },
          "then": [{ "type": "SET_VALUE", "target": "a", "payload": { "value": 1 } }]
        }
      ],
      "expect": { "stable": false }
    },

    {
      "name": "引用不存在的字段：条件按未满足处理，不抛错",
      "trigger": "CHANGE",
      "data": {},
      "rules": [
        {
          "id": "r1",
          "trigger": "CHANGE",
          "when": {
            "logic": "AND",
            "items": [{ "field": "notExists", "operator": "EQ", "value": "x" }]
          },
          "then": [{ "type": "REQUIRE", "target": "y" }],
          "otherwise": [{ "type": "OPTIONAL", "target": "y" }]
        }
      ],
      "expect": { "state": { "y": { "required": false } }, "stable": true }
    },
    {
      "name": "动作缺少 target 时整条动作被忽略，其余动作照常执行",
      "trigger": "CHANGE",
      "data": {},
      "rules": [
        {
          "id": "r1",
          "trigger": "CHANGE",
          "when": null,
          "then": [
            { "type": "HIDE", "target": "" },
            { "type": "HIDE", "target": "good" }
          ]
        }
      ],
      "expect": { "state": { "good": { "visible": false } }, "stable": true }
    },
    {
      "name": "未知的操作符按不满足处理",
      "trigger": "CHANGE",
      "data": { "a": 1 },
      "rules": [
        {
          "id": "r1",
          "trigger": "CHANGE",
          "when": {
            "logic": "AND",
            "items": [{ "field": "a", "operator": "NOT_A_REAL_OPERATOR", "value": 1 }]
          },
          "then": [{ "type": "REQUIRE", "target": "y" }]
        }
      ],
      "expect": { "state": { "y": { "required": false } }, "stable": true }
    },
    {
      "name": "未知的动作类型被忽略",
      "trigger": "CHANGE",
      "data": {},
      "rules": [
        {
          "id": "r1",
          "trigger": "CHANGE",
          "when": null,
          "then": [
            { "type": "NOT_A_REAL_ACTION", "target": "x" },
            { "type": "HIDE", "target": "y" }
          ]
        }
      ],
      "expect": { "state": { "y": { "visible": false } }, "stable": true }
    },
    {
      "name": "基础状态里的 required 被保留（来自控件的 $required）",
      "trigger": "CHANGE",
      "data": {},
      "baseState": { "mustFill": { "required": true } },
      "rules": [],
      "expect": { "state": { "mustFill": { "required": true } }, "stable": true }
    },
    {
      "name": "⚠️ 隐藏字段同时失去可编辑性：隐藏了还能提交值就是绕过入口",
      "trigger": "SUBMIT",
      "data": {},
      "rules": [
        {
          "id": "r1",
          "trigger": "SUBMIT",
          "when": null,
          "then": [{ "type": "HIDE", "target": "secret" }]
        }
      ],
      "expect": {
        "state": { "secret": { "visible": false, "editable": false } },
        "stable": true
      }
    }
  ]
}
